# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pyd

# ==========================================
# Virtual environments
# ==========================================
.venv/
venv/
env/
ENV/

# ==========================================
# Jupyter notebooks
# ==========================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*.nbconvert.ipynb

# ==========================================
# IDE and editor files
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Logs and temporary files
# ==========================================
*.log
logs/
tmp/
temp/

# ==========================================
# Test and coverage files
# ==========================================
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Build and packaging artifacts
# ==========================================
build/
dist/
*.egg-info/

# ==========================================
# Notebook outputs and local exports
# Uncomment if you want to ignore notebook exports
# ==========================================
# notebooks/exports/

# ==========================================
# Local dataset files
# Uncomment if you do not want to commit the dataset
# ==========================================
# notebooks/data/*.csv
# notebooks/data/*.xlsx

# ==========================================
# Model files
# Keep the trained model tracked if required by the app
# Uncomment to ignore model files instead
# ==========================================
# models/*.dill
# models/*.pkl
# models/*.joblib